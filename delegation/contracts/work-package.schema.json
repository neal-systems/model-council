{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded work package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "objective", "lane", "allowed_scope", "expected_changes", "prohibited_changes", "acceptance_criteria", "verification", "environment", "escalation", "authority", "contract_version"],
  "properties": {
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "objective": {"type": "string", "minLength": 10},
    "lane": {"enum": ["standard", "deterministic"]},
    "allowed_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_changes": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {"id": {"type": "string", "pattern": "^AC[0-9]+$"}, "text": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["commands", "required_artifacts"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "satisfies", "cmd", "expected_exit_code", "timeout_seconds"],
            "properties": {
              "id": {"type": "string"},
              "satisfies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "cmd": {"type": "string"},
              "expected_exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
              "expected_stdout_match": {"type": "string"},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
            }
          }
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "must_exist"],
            "properties": {"path": {"type": "string"}, "must_exist": {"type": "boolean"}, "must_contain": {"type": "string"}}
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["network_required", "required_paths"],
      "properties": {
        "network_required": {"type": "boolean"},
        "required_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "escalation": {
      "type": "object",
      "required": ["primary_max_failures", "senior_max_failures", "resolver_max_failures", "deterministic_max_failures"],
      "properties": {
        "primary_max_failures": {"type": "integer", "minimum": 1, "maximum": 5},
        "senior_max_failures": {"type": "integer", "minimum": 1, "maximum": 5},
        "resolver_max_failures": {"type": "integer", "minimum": 1, "maximum": 5},
        "deterministic_max_failures": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "authority": {"enum": ["architect", "owner"]},
    "contract_version": {"type": "integer", "minimum": 1}
  }
}
